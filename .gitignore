# macOS
.DS_Store

# Xcode 构建产物（本地任意 derivedDataPath）
build/
build-*/
DerivedData/
*.xcresult
*.xcactivitylog
*.xcscmblueprint

# Xcode 用户态文件（不要提交）
**/xcuserdata/
*.xcuserstate

# 三方库构建中间产物
Vendor/ffmpeg/build/
Vendor/ffmpeg/host-build/
Vendor/ffmpeg/build.log
Vendor/libass/src/
Vendor/libass/build.log

# 本地工具/内部记录
.workbuddy/
.opencode/
.env
.env.*

# 编辑器/系统临时文件
*.swp
*.tmp
*.orig
__pycache__/

# 压测/验收报告：本地产物（真机跑出来的数据与报告），不入库
# 注意：规范类文档不要用 acceptance-<日期> 这类名字，否则会命中下面的规则
docs/acceptance-*.json
docs/acceptance-*.md
docs/startup-acceptance-*-*.json
docs/startup-acceptance-*-*.md
docs/startup-baseline-*.json
docs/startup-baseline-*.md
