             av_log(matroska->ctx, AV_LOG_ERROR, "incomplete attachment\n");
@@ -3445,6 +3486,12 @@ static int matroska_read_header(AVFormatContext *s)
         }
     }
 
+    if (skipped_fonts > 0) {
+        char skipped_buf[32];
+        snprintf(skipped_buf, sizeof(skipped_buf), "%d", skipped_fonts);
+        av_dict_set(&s->metadata, "icemovie_skipped_font_count", skipped_buf, 0);
+    }
