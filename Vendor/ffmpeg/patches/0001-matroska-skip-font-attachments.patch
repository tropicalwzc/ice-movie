@@ -436,6 +436,9 @@ typedef struct MatroskaDemuxContext {
 
     /* WebM DASH Manifest live flag */
     int is_live;
+    /* IceMovie: skip font attachment payloads during playback open. */
+    int skip_font_attachments;
+    int current_attachment_is_font;
 
