 static int ebml_parse(MatroskaDemuxContext *matroska,
                       EbmlSyntax *syntax, void *data);
 
+static int icemovie_is_font_mime(const char *mime)
+{
+    if (!mime)
+        return 0;
+    return !strncmp(mime, "font/", 5) ||
+           !strncmp(mime, "application/font", 16) ||
+           !strncmp(mime, "application/x-font", 18) ||
+           !strcmp(mime, "application/vnd.ms-opentype") ||
+           !strcmp(mime, "application/vnd.ms-fontobject") ||
+           !strcmp(mime, "application/x-truetype-font") ||
+           !strcmp(mime, "application/x-font-ttf") ||
+           !strcmp(mime, "application/x-font-opentype");
+}
+
 static EbmlSyntax *ebml_parse_id(EbmlSyntax *syntax, uint32_t id)
 {
     int i;
@@ -1491,9 +1508,24 @@ static int ebml_parse(MatroskaDemuxContext *matroska,
     case EBML_STR:
     case EBML_UTF8:
         res = ebml_read_ascii(pb, length, syntax->def.s, data);
+        if (!res && id == MATROSKA_ID_FILEMIMETYPE && data)
+            matroska->current_attachment_is_font =
+                icemovie_is_font_mime(*(char **)data);
         break;
     case EBML_BIN:
-        res = ebml_read_binary(pb, length, pos_alt, data);
+        if (id == MATROSKA_ID_FILEDATA && data &&
+            matroska->skip_font_attachments &&
+            matroska->current_attachment_is_font) {
+            EbmlBin *bin = data;
+            memset(bin, 0, sizeof(*bin));
+            bin->pos = pos_alt;
+            if (avio_skip(pb, length) < 0)
+                res = AVERROR(EIO);
+            else
+                res = 0;
+        } else {
+            res = ebml_read_binary(pb, length, pos_alt, data);
+        }
         break;
     case EBML_LEVEL1:
     case EBML_NEST:
@@ -1512,6 +1544,8 @@ static int ebml_parse(MatroskaDemuxContext *matroska,
                 av_log(matroska->ctx, AV_LOG_ERROR, "Duplicate element\n");
             level1_elem->parsed = 1;
         }
+        if (id == MATROSKA_ID_ATTACHEDFILE)
+            matroska->current_attachment_is_font = 0;
         if (res = ebml_parse_nest(matroska, syntax->def.n, data))
             return res;
         break;
@@ -3324,6 +3358,7 @@ static int matroska_read_header(AVFormatContext *s)
     int64_t pos;
