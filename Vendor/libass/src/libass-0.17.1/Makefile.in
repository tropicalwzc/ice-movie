@am__fastdepCC_TRUE@	$(AM_V_CC)$(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(compare_compare_CPPFLAGS) $(CPPFLAGS) $(AM_CFLAGS) $(CFLAGS) -MT compare/compare-image.o -MD -MP -MF compare/$(DEPDIR)/compare-image.Tpo -c -o compare/compare-image.o `test -f 'compare/image.c' || echo '$(srcdir)/'`compare/image.c
@am__fastdepCC_TRUE@	$(AM_V_at)$(am__mv) compare/$(DEPDIR)/compare-image.Tpo compare/$(DEPDIR)/compare-image.Po
@AMDEP_TRUE@@am__fastdepCC_FALSE@	$(AM_V_CC)source='compare/image.c' object='compare/compare-image.o' libtool=no @AMDEPBACKSLASH@
