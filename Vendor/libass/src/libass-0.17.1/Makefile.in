.asm.lo:
	$(nasm_verbose)$(LIBTOOL) $(AM_V_lt) --tag=CC --mode=compile $(top_srcdir)/ltnasm.sh $(AS) $(ASFLAGS) -I$(top_srcdir)/libass/ -Dprivate_prefix=ass -o $@ $<

@ENABLE_FUZZ_TRUE@fuzz/fuzz_ossfuzz: fuzz/fuzz-fuzz.o libass/libass.la $(srcdir)/libass.pc
@ENABLE_FUZZ_TRUE@	$$CXX $$CXXFLAGS -std=c++11 \
@ENABLE_FUZZ_TRUE@		-o $@ \
@ENABLE_FUZZ_TRUE@		fuzz/fuzz-fuzz.o \
@ENABLE_FUZZ_TRUE@		$$LIB_FUZZING_ENGINE libass/.libs/libass.a \
@ENABLE_FUZZ_TRUE@		-Wl,-Bstatic \
@ENABLE_FUZZ_TRUE@		$$(pkg-config --static --libs $(srcdir)/libass.pc | sed -e 's/-lm //g' -e 's/-lass //g') \
@ENABLE_FUZZ_TRUE@		-Wl,-Bdynamic

# Tests
@ENABLE_FUZZ_TRUE@check: check-art-fuzz
@ENABLE_FUZZ_TRUE@.PHONY: check-art-fuzz
@ENABLE_FUZZ_TRUE@check-art-fuzz: fuzz/fuzz
@ENABLE_FUZZ_TRUE@	@if [ -z '$(ART_SAMPLES)' ] ; then \
@ENABLE_FUZZ_TRUE@		echo "ART_SAMPLES location not set; cannot run regression tests!"; \
@ENABLE_FUZZ_TRUE@	else \
@ENABLE_FUZZ_TRUE@		cd '$(ART_SAMPLES)'/crash/ ; \
@ENABLE_FUZZ_TRUE@		./run-all.sh '$(abs_top_builddir)'/fuzz/fuzz ; \
@ENABLE_FUZZ_TRUE@	fi

@ENABLE_COMPARE_TRUE@check: check-art-compare
@ENABLE_COMPARE_TRUE@.PHONY: check-art-compare
@ENABLE_COMPARE_TRUE@check-art-compare: compare/compare
@ENABLE_COMPARE_TRUE@	@if [ -z '$(ART_SAMPLES)' ] ; then \
@ENABLE_COMPARE_TRUE@		echo "ART_SAMPLES location not set; cannot run regression tests!"; \
@ENABLE_COMPARE_TRUE@	else \
@ENABLE_COMPARE_TRUE@		cd '$(ART_SAMPLES)'/regression/ ; \
@ENABLE_COMPARE_TRUE@		./run-all.sh '$(abs_top_builddir)'/compare/compare ; \
@ENABLE_COMPARE_TRUE@	fi

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:
